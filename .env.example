# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (leave blank to use SQLite default)
# DATABASE_URL=postgresql://user:password@localhost:5432/villematic

# Payment gateway (for future Stripe integration)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── MTN MoMo Collections API ──────────────────────────────────────────────────
# 1. Obtain your Subscription Key from https://momodeveloper.mtn.com → Collections
# 2. Paste it as MOMO_SUBSCRIPTION_KEY below
# 3. Run:  python scripts/test_momo_sandbox.py
#    → This will auto-save MOMO_API_USER and MOMO_API_KEY into this file.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your-ocp-apim-subscription-key-here
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CURRENCY=EUR
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_HOST=
