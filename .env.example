# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (leave blank to use SQLite default)
# DATABASE_URL=postgresql://user:password@localhost:5432/villematic

# Payment gateway (for future Stripe integration)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── MTN MoMo Collections API ──────────────────────────────────────────────────
# Obtain these from https://momodeveloper.mtn.com → Collections product
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com   # sandbox
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com           # production
# MOMO_SUBSCRIPTION_KEY=your-ocp-apim-subscription-key-here
# MOMO_API_USER=your-api-user-uuid-here
# MOMO_API_KEY=your-api-key-here
# MOMO_CURRENCY=EUR          # use EUR for sandbox; RWF/UGX/GHS etc. for production
# MOMO_ENVIRONMENT=sandbox   # 'sandbox' or 'production'
# MOMO_CALLBACK_HOST=https://yourdomain.com  # public URL that MoMo will POST to
