# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (leave blank to use SQLite default)
# DATABASE_URL=postgresql://user:password@localhost:5432/villematic

# Email
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── MTN MoMo Collection Widget ──────────────────────────────────────────────
# Sandbox widget script URL (swap for production URL when going live)
MOMO_WIDGET_SCRIPT_URL=https://widget.northeurope.cloudapp.azure.com:9443/v0.1.0/mobile-money-widget-mtn.js

# API User UUID — must correspond to an API user provisioned via the MoMo
# sandbox provisioning API (https://momodeveloper.mtn.com).
# If unset, an ephemeral UUID is auto-generated on each server start.
MOMO_SANDBOX_API_USER_ID=

# Currency: EUR for sandbox testing, RWF / UGX / etc. for production
MOMO_CURRENCY=EUR

# Default demo amount shown on the payment page (overridable via ?amount=N)
MOMO_DEMO_AMOUNT=100

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
